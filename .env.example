# Get a free API key at https://otx.alienvault.com/
OTX_API_KEY=your_alienvault_otx_api_key_here

# Optional: Slack Incoming Webhook URL for real-time SOC alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0000/B0000/XXXX

# Set to "true" to test the full pipeline using realistic simulated pulses without an API key
MOCK_MODE=true

# Lookback window in hours for fetching pulses
LOOKBACK_HOURS=24